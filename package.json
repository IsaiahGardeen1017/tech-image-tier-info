        "test": "tsx --test test/*.test.ts"
    },
    "dependencies": {
        "archiver": "^7.0.1",
        "pngjs": "^7.0.0"
    },
    "devDependencies": {
        "@types/archiver": "^6.0.3",
        "@types/node": "^24.0.0",
        "@types/pngjs": "^6.0.5",
        "tsx": "^4.20.0",
        "typescript": "^5.9.0"
    }
}
